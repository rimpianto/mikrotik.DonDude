# Copy to .env and fill in. Both values are required.

# PostgreSQL password. Any strong random string; it is only used between the
# two containers.
POSTGRES_PASSWORD=change-me

# Encrypts the router passwords and the GitHub token stored in the database.
# Generate with:
#   docker compose run --rm --no-deps app keygen
#
# Keep a copy somewhere safe: without this key the stored credentials cannot be
# decrypted, and every device has to be given its password again.
DONDUDE_MASTER_KEY=

# Optional: raise log detail.
# RUST_LOG=mikrotik_dondude=debug,info
